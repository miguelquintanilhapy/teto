{
  "name": "teto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "check:ai": "tsx --env-file=.env.local scripts/check-ai.mts",
    "fixtures:generate": "tsx scripts/generate-fixtures.mts",
    "eval": "tsx scripts/eval.mts",
    "eval:record": "tsx --env-file=.env.local scripts/eval.mts --mode record",
    "seed": "tsx --env-file=.env.local scripts/seed-demo.mts",
    "check:db": "tsx --env-file=.env.local scripts/check-db.mts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo-data.mts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "typescript-eslint": "8.73.0"
  },
  "engines": {
    "node": ">=24"
  }
}
