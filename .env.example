# Copie para .env.local e preencha. NUNCA commite o .env.local.

# --- Provedores de IA (todos com plano gratuito) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Cadeia de modelos, do mais barato ao mais forte, separada por vírgula.
# Formato: provedor:modelo. Confira os nomes atuais no AI Studio e no OpenRouter.
# Exemplo: gemini:<modelo-flash-lite>,gemini:<modelo-flash>,openrouter:<modelo-free-com-visao>
MODEL_CHAIN=

# --- Supabase (banco + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail de alertas ---
RESEND_API_KEY=

# --- Protege a rota do cron de alertas (mínimo de 16 caracteres) ---
CRON_SECRET=

# --- Teto diário de extrações com IA (protege a cota gratuita) ---
EXTRACTION_DAILY_QUOTA=200
