# Copie para .env.local e preencha. NUNCA commite o .env.local.

# --- Provedores de IA (todos com plano gratuito) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Cadeia de modelos, do mais leve ao mais forte, em UMA linha, separada por vírgula, sem espaços.
# Formato: provedor:modelo. Os nomes mudam com o tempo: confira no AI Studio e no OpenRouter.
# Valor usado pelo time:
# MODEL_CHAIN=gemini:gemini-3.1-flash-lite,gemini:gemini-3.8-flash,openrouter:nvidia/nemotron-3.5-super-vl:free
MODEL_CHAIN=

# --- Supabase (banco + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail de alertas ---
RESEND_API_KEY=

# --- Protege a rota do cron de alertas (mínimo de 16 caracteres) ---
CRON_SECRET=

# --- Teto diário de extrações com IA (protege a cota gratuita) ---
EXTRACTION_DAILY_QUOTA=200

# --- Opcional: e-mail do perfil de demonstração (usado só pelo `npm run seed`) ---
DEMO_PROFILE_EMAIL=
